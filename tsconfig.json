{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "scripts/**/*.ts",
    "projects/cms-web/scripts/*.ts",
    "projects/videostream/scripts/*.ts",
    "projects/tlis-streamserver-docker/scripts/*.ts"
  ]
}
