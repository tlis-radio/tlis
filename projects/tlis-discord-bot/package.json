{
  "name": "tlis-discord-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TLIS Discord bot with Minimal API-style vertical slices and calendar integration",
  "engines": {
    "node": ">=24.17.0 <25"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "commands": "node --env-file-if-exists=.env --import tsx tools/register-commands.ts"
  },
  "dependencies": {
    "discord.js": "14.28.0",
    "node-ical": "0.27.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
