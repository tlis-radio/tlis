# HTTP health server works without Discord credentials.
HOST=127.0.0.1
PORT=3002
BOT_ENABLED=false
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=
# Read-only HTTPS iCalendar feed, including exported Google/Outlook calendar feeds.
# Feed URLs may contain access tokens; keep this value private.
CALENDAR_ICS_URL=
CALENDAR_TIME_ZONE=Europe/Bratislava
