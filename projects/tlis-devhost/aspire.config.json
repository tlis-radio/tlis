{
  "$schema": "https://aspire.dev/reference/cli/configuration/schema/13.6.0.json",
  "appHost": { "path": "apphost.mts", "language": "typescript/nodejs" },
  "sdk": { "version": "13.6.0" },
  "packages": { "Aspire.Hosting.JavaScript": "13.6.0" },
  "profiles": {
    "default": {
      "applicationUrl": "http://localhost:15888",
      "environmentVariables": {
        "ASPIRE_ALLOW_UNSECURED_TRANSPORT": "true",
        "ASPIRE_DASHBOARD_OTLP_ENDPOINT_URL": "http://localhost:18889",
        "ASPIRE_RESOURCE_SERVICE_ENDPOINT_URL": "http://localhost:18890"
      }
    }
  }
}
