# Only local development services. No source-repository credentials are loaded.
TLIS_DIRECTUS_URL=http://localhost:8055
TLIS_ENABLE_AUDIO=false
TLIS_ENABLE_VIDEO=false
# Required only when video is enabled; use a token from your LOCAL Directus.
TLIS_DIRECTUS_TOKEN=
TLIS_FFMPEG_PATH=ffmpeg
TLIS_STREAMS_COLLECTION=streams
# Optional absolute executable path if Aspire 13.6.0 is not on PATH.
ASPIRE_CLI_PATH=
