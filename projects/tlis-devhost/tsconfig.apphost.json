{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": ["apphost.mts", "src/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts", ".aspire/modules/*.mts"],
  "exclude": ["node_modules"]
}
