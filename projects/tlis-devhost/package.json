{
  "name": "tlis-devhost",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Aspire development host for the independent TLIS applications",
  "engines": { "node": ">=24.17.0 <25" },
  "scripts": {
    "restore": "node --env-file-if-exists=.env scripts/aspire.ts restore",
    "dev": "node --env-file-if-exists=.env scripts/aspire.ts run",
    "stop": "node --env-file-if-exists=.env scripts/aspire.ts stop",
    "build": "tsc -p tsconfig.apphost.json --noEmit",
    "test": "node --test tests/*.test.ts",
    "check": "node scripts/check.ts",
    "plan": "node --env-file-if-exists=.env scripts/plan.ts"
  },
  "dependencies": { "vscode-jsonrpc": "8.2.0" },
  "devDependencies": {
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
